# Server only; never put this in mobile.
# Use the Supabase *Transaction* pooler (port 6543). The Session pooler (5432) gives each
# running backend its own connections and runs out when several teammates' servers are up,
# which makes every database request (including login) hang.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
DATABASE_SSL=true
PORT=5000

# Optional local-only POI; ignored in production. Never writes to the database.
LOCAL_TEST_POI_ENABLED=false
LOCAL_TEST_POI_LATITUDE=
LOCAL_TEST_POI_LONGITUDE=
# Optional source to clone, including metadata, images, radius and cooldown (P11 = Citywalk).
LOCAL_TEST_POI_SOURCE_ID=
