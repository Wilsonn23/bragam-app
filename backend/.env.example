# Server only. Use the Supabase Session Pooler string; never put this in mobile.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true
PORT=5000

# Optional. Signs login tokens on the server (never shipped in the APK).
# Leave empty to auto-generate one into backend/.auth-secret on first start.
# Set it explicitly (32+ random chars) if you run several server instances that must share sessions.
AUTH_SECRET=

# Optional local-only POI; ignored in production. Never writes to the database.
LOCAL_TEST_POI_ENABLED=false
LOCAL_TEST_POI_LATITUDE=
LOCAL_TEST_POI_LONGITUDE=
# Optional source to clone, including metadata, images, radius and cooldown (P11 = Citywalk).
LOCAL_TEST_POI_SOURCE_ID=
